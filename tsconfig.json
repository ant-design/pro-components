{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "declaration": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@ant-design/pro-components": ["./src"],
      "src": ["./src"],
      "src/*": ["./src/*"],
      "@rspress/core/runtime": ["./node_modules/@rspress/core/dist/runtime/index.d.ts"],
      "@rspress/core/theme-original": ["./node_modules/@rspress/core/dist/theme/index.d.ts"]
    }
  },
  "include": [
    "vitest.config.mts",
    "tests/**/**/*.tsx",
    "tests/**/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "typings.d.ts",
    "src/**/*",
    "demos/**/*"
  ]
}
