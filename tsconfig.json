{
  "compilerOptions": {
    "baseUrl": "./",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "declaration": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@ant-design/pro-components": ["src"],
      "src": ["src"],
      "src/*": ["src/*"],
      "@rspress/core/runtime": ["node_modules/@rspress/core/dist/runtime/index.d.ts"],
      "@rspress/core/theme-original": ["node_modules/@rspress/core/dist/theme/index.d.ts"]
    }
  },
  "include": [
    "rspress.config.ts",
    "vitest.config.mts",
    "theme/**/*.ts",
    "theme/**/*.tsx",
    "tests/**/**/*.tsx",
    "tests/**/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "typings.d.ts",
    "src/**/*",
    "demos/**/*"
  ]
}
